# x402scan configuration. Copy to .env (gitignored) or set in your host.
# Everything here is optional — with none of it set, the free tier serves
# every request and billing endpoints return a clear 503.

# --- Stripe (required only for paid tiers) -------------------------------
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Price IDs (price_..., NOT product prod_...). Create in Stripe, paste here.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_INTEL=

# From `stripe listen` locally, or the dashboard webhook endpoint in production.
# Without this, /api/webhook refuses every request — which is the safe default.
STRIPE_WEBHOOK_SECRET=

# Absolute origin for Stripe redirect URLs. Inferred from the request if unset.
PUBLIC_ORIGIN=

# --- Static keys (partners, internal, comps) -----------------------------
# Comma-separated key:tier pairs. Checked before Stripe.
X402SCAN_KEYS=
